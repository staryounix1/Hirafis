# SUPABASE_URL: Your Supabase project URL (e.g. https://xyzcompany.supabase.co)
# Configure this in the Secrets panel in AI Studio.
SUPABASE_URL=YOUR_SUPABASE_URL

# SUPABASE_ANON_KEY: Your Supabase project anon/public key.
# Configure this in the Secrets panel in AI Studio.
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# CARTO_API_KEY: API key from carto.com for Voyager & Dark Matter basemap tiles.
# Configure this in the Secrets panel in AI Studio.
CARTO_API_KEY=YOUR_CARTO_API_KEY
